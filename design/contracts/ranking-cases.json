{
  "version": "1.0.0",
  "scope": "纯业务规则向量；不是支付验签、真实并发或生产服务的测试报告。测试逻辑ID用A/B，落地数据库使用merchantCategory UUID。",
  "cases": [
    {
      "id": "cumulative_topup",
      "description": "追加款累加，不是只取最后一次金额",
      "events": [
        {
          "eventId": "evt-p1",
          "reference": "p1",
          "merchant": "A",
          "category": "headphones",
          "kind": "PAYMENT",
          "status": "SUCCEEDED",
          "verified": true,
          "amountFen": 10000,
          "committedAt": "2026-10-27T00:01:00.000Z"
        },
        {
          "eventId": "evt-p2",
          "reference": "p2",
          "merchant": "A",
          "category": "headphones",
          "kind": "PAYMENT",
          "status": "SUCCEEDED",
          "verified": true,
          "amountFen": 20000,
          "committedAt": "2026-10-27T00:02:00.000Z"
        },
        {
          "eventId": "evt-p3",
          "reference": "p3",
          "merchant": "B",
          "category": "headphones",
          "kind": "PAYMENT",
          "status": "SUCCEEDED",
          "verified": true,
          "amountFen": 25000,
          "committedAt": "2026-10-27T00:03:00.000Z"
        }
      ],
      "expected": {
        "boards": {
          "headphones": [
            "A",
            "B"
          ]
        },
        "balances": {
          "A|headphones": {
            "grossFen": 30000,
            "refundedFen": 0,
            "netFen": 30000
          },
          "B|headphones": {
            "grossFen": 25000,
            "refundedFen": 0,
            "netFen": 25000
          }
        }
      }
    },
    {
      "id": "duplicate_receipt",
      "description": "渠道交易重复，即使事件ID不同也只入账一次",
      "events": [
        {
          "eventId": "evt-p1",
